# Database (Prisma)
DATABASE_URL="postgresql://user:password@localhost:5432/ecokon"

# NextAuth
NEXTAUTH_URL="https://pro-pochvu.ru"
NEXTAUTH_SECRET="your-secret-here"

# YooKassa
YOOKASSA_SHOP_ID="your-shop-id"
YOOKASSA_SECRET_KEY="your-secret-key"

# ApiShip (мультидоставка)
APISHIP_API_KEY="your-api-key"
APISHIP_FROM_CITY_ID="1"
APISHIP_PLATFORM_ID="your-platform-id"
APISHIP_WEBHOOK_SECRET="your-webhook-secret"

# Telegram уведомления
TELEGRAM_BOT_TOKEN="your-bot-token"
TELEGRAM_CHAT_ID="your-chat-id"

# Email SMTP (Mail.ru для бизнеса)
EMAIL_SMTP_HOST=smtp.mail.ru
EMAIL_SMTP_PORT=465
EMAIL_SMTP_USER=noreply@pro-pochvu.ru
EMAIL_SMTP_PASS=your-app-password
EMAIL_SMTP_FROM=Эко Конь <noreply@pro-pochvu.ru>
EMAIL_SMTP_SECURE=true

# Публичные переменные (зашиваются при build)
NEXT_PUBLIC_SITE_URL="https://pro-pochvu.ru"
NEXT_PUBLIC_YMAPS_API_KEY="your-yandex-maps-api-key"
NEXT_PUBLIC_METRIKA_ID="your-metrika-id"
NEXT_PUBLIC_VK_PIXEL_ID="your-vk-pixel-id"

# Серверный канал Я.Метрики — offline conversions API.
# Используется в /api/payment/webhook как fallback цели `purchase`
# (если клиент заблокировал Метрику или не дошёл до /order/[id]).
# Получить токен: https://oauth.yandex.ru/ → приложение с правом «Метрика: запись».
# Если пусто — серверный канал тихо отключается, клиентский трекинг работает как обычно.
YANDEX_OAUTH_TOKEN=""

# SEO verification (получить в панелях вебмастера)
# Яндекс.Вебмастер → Настройки → Права на управление → HTML-meta
NEXT_PUBLIC_YANDEX_VERIFICATION=""
# Google Search Console → Settings → Ownership verification → HTML tag
NEXT_PUBLIC_GOOGLE_VERIFICATION=""
# Mail.ru вебмастер (опционально)
NEXT_PUBLIC_MAILRU_VERIFICATION=""

# IndexNow API key (общий для Яндекса/Bing — любая 8–128-символьная строка hex/alphanum)
# Файл-подтверждение отдаётся динамически по адресу /{INDEXNOW_KEY}.txt
# (через middleware → /api/indexnow/verify, в /public ничего класть не нужно)
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INDEXNOW_KEY=""

# Админ-токен для серверных вызовов /api/indexnow/* и других admin endpoint'ов
# (cron, скрипты деплоя). Заголовок: X-Admin-Token
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_TOKEN=""

# === AI-ассистент сайта (ConOmni + bot-kit) ===
# Публичный токен виджета ConOmni — зашивается в бандл при сборке (build-arg в CI).
NEXT_PUBLIC_CONOMNI_WIDGET_TOKEN=""
# Общий секрет для инструмента бота search_catalog (GET /api/catalog/search).
# Серверный, НЕ build-arg. Без него эндпоинт отвечает 401 всем.
BOT_API_SECRET=""
